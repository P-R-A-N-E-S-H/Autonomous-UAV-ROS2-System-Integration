<?xml version="1.0" ?>
<!--
  warehouse_inspection.sdf
  ========================
  Gazebo Harmonic (Gz-Sim 8) Simulation World for GPS-Denied Autonomous UAV Inspection.
  Author: Member 2 (Simulation & Flight Stack Engineer)
-->
<sdf version="1.8">
  <world name="warehouse_inspection_world">
    
    <!-- Physics Engine Configuration (1000Hz Deterministic Step) -->
    <physics name="1ms_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <!-- Gazebo Systems / Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Lighting -->
    <light type="directional" name="overhead_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.32 0.35 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Enclosure Walls (GPS-Denied Indoor Structure) -->
    <model name="warehouse_walls">
      <static>true</static>
      <link name="walls_link">
        <!-- North Wall -->
        <collision name="north_col">
          <pose>0 15 3.5 0 0 0</pose>
          <geometry><box><size>30 0.4 7.0</size></box></geometry>
        </collision>
        <visual name="north_vis">
          <pose>0 15 3.5 0 0 0</pose>
          <geometry><box><size>30 0.4 7.0</size></box></geometry>
          <material><ambient>0.6 0.65 0.7 1</ambient><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>

        <!-- South Wall -->
        <collision name="south_col">
          <pose>0 -15 3.5 0 0 0</pose>
          <geometry><box><size>30 0.4 7.0</size></box></geometry>
        </collision>
        <visual name="south_vis">
          <pose>0 -15 3.5 0 0 0</pose>
          <geometry><box><size>30 0.4 7.0</size></box></geometry>
          <material><ambient>0.6 0.65 0.7 1</ambient><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>

        <!-- East Wall -->
        <collision name="east_col">
          <pose>15 0 3.5 0 0 0</pose>
          <geometry><box><size>0.4 30 7.0</size></box></geometry>
        </collision>
        <visual name="east_vis">
          <pose>15 0 3.5 0 0 0</pose>
          <geometry><box><size>0.4 30 7.0</size></box></geometry>
          <material><ambient>0.6 0.65 0.7 1</ambient><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>

        <!-- West Wall -->
        <collision name="west_col">
          <pose>-15 0 3.5 0 0 0</pose>
          <geometry><box><size>0.4 30 7.0</size></box></geometry>
        </collision>
        <visual name="west_vis">
          <pose>-15 0 3.5 0 0 0</pose>
          <geometry><box><size>0.4 30 7.0</size></box></geometry>
          <material><ambient>0.6 0.65 0.7 1</ambient><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inspection Target 1: Red Medical Supply Crate (Member 1 VLM Target) -->
    <model name="medical_supply_crate">
      <static>true</static>
      <pose>4.5 3.2 1.0 0 0 0.45</pose>
      <link name="crate_link">
        <collision name="crate_col">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="crate_vis">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inspection Target 2: Yellow Hazmat Chemical Drum (Member 5 Memory Target) -->
    <model name="hazmat_container">
      <static>true</static>
      <pose>-3.8 6.1 0.75 0 0 0</pose>
      <link name="drum_link">
        <collision name="drum_col">
          <geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="drum_vis">
          <geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.8 0.1 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inspection Target 3: Elevated Survivor Landing Pad Alpha -->
    <model name="landing_pad_alpha">
      <static>true</static>
      <pose>1.2 -4.5 0.15 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_col">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
        </collision>
        <visual name="pad_vis">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
          <material>
            <ambient>0.2 0.7 0.9 1</ambient>
            <diffuse>0.2 0.7 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
