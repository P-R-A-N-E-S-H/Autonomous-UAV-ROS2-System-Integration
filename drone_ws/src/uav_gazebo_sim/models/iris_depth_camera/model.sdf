<?xml version="1.0" ?>
<!--
  model.sdf: Iris Quadrotor with Depth Camera & ArduPilot Plugin (Gazebo Harmonic)
  Author: Member 2 (Simulation & Flight Stack Engineer)
-->
<sdf version="1.8">
  <model name="iris_depth_camera">
    <pose>0 0 0.1 0 0 0</pose>

    <!-- Main Fuselage Link -->
    <link name="base_link">
      <inertial>
        <mass>1.450</mass>
        <inertia>
          <ixx>0.0142</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0142</iyy>
          <iyz>0</iyz>
          <izz>0.0245</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
      </collision>
      <visual name="base_link_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>

      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Front-Mounted RGB-D Depth Camera -->
      <sensor name="depth_camera" type="rgbd_camera">
        <pose>0.12 0 0.05 0 0.2618 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov> <!-- 87 deg FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>15.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.2</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </link>

    <!-- Gazebo Harmonic Multicopter Motor Model Systems -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>iris</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    </plugin>

    <!-- ArduPilot Plugin for Gazebo Harmonic SITL -->
    <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5000</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <gazebo_frame_rate>1000</gazebo_frame_rate>
      <!-- Control Channels Mapping -->
      <controls>
        <control channel="0">
          <type>VELOCITY</type>
          <offset>0</offset>
          <p_gain>0.20</p_gain>
          <i_gain>0</i_gain>
          <d_gain>0</d_gain>
          <i_max>0</i_max>
          <i_min>0</i_min>
          <cmd_max>2.5</cmd_max>
          <cmd_min>-2.5</cmd_min>
          <jointName>rotor_0_joint</jointName>
          <multiplier>1000</multiplier>
        </control>
      </controls>
    </plugin>

  </model>
</sdf>
